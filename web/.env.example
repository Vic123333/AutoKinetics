# ── Copy to .env and fill in values ────────────────────────────────────────────
# NEVER commit .env to version control.

# ── Django core ────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-REPLACE-ME

DEBUG=False

# Comma-separated list of allowed host names
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# ── Application limits ─────────────────────────────────────────────────────────
SIMULATION_TIMEOUT_S=30
MAX_SPECIES=20
MAX_REACTIONS=50

# API rate limit (Django REST Framework AnonRateThrottle)
# Format: N/period  where period is second, minute, hour, day
THROTTLE_RATE=30/minute

# ── Gunicorn ───────────────────────────────────────────────────────────────────
PORT=8000
GUNICORN_WORKERS=4
LOG_LEVEL=info
